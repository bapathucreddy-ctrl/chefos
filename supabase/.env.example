# Configure through Supabase secrets; never put these in a VITE_ or EXPO_PUBLIC_ variable.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CHEFOS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
OPENAI_API_KEY=
CHEFOS_MENU_MODEL=
CHEFOS_MENU_PROVIDER=openai
# For a custom adapter instead, choose custom and supply this HTTPS gateway.
CHEFOS_MENU_PROVIDER_URL=
CHEFOS_MENU_PROVIDER_KEY=
CHEFOS_JOB_SECRET=
CHEFOS_FACE_PROVIDER_URL=
CHEFOS_FACE_PROVIDER_KEY=
CHEFOS_FACE_WEBHOOK_SECRET=
CHEFOS_FACE_ALLOWED_ORIGINS=
# Native registration/visit selfies use Didit's standalone APIs.
DIDIT_API_KEY=
CHEFOS_FACE_MATCH_THRESHOLD=50
CHEFOS_LIVENESS_THRESHOLD=30
